---
import Layout from '../layouts/Layout.astro';
import Divider from '../components/Divider.astro';
import { getCollection } from 'astro:content';
import { homePageContent } from '../config.js';
import { formatDate } from '../utils';
import Link from '../components/Link.astro';

const posts = await getCollection("posts")
const lastPost = posts[0]
---

<Layout	seo={homePageContent.seo}>
	<main>
		<!-- Lo último -->
		<section class="py-4">
			<p class="text-xl opacity-70 mb-4">Lo último</p>
			<a href={`/${lastPost.slug}`}>
				<div class="last--post cursor-pointer">
					<h2 class="text-2xl">
						<span class="inline-block rounded-bl-lg rounded-tl-3xl rounded-tr-md rounded-br-sm transition-colors duration-300">
							{lastPost.data.title}
						</span>
					</h2>
					<p class="mb-0 opacity-70">{formatDate(lastPost.data.date)}</p>
					<p class="font-sans mb-4">
						{lastPost.data.description}
					</p>
					<button class="opacity-70">
						Continuar leyendo →
					</button>
				</div>
			</a>
		</section>

		<Divider />

		<!-- Mis otros escritos -->
		<section class="py-4">
			<p class="text-xl opacity-70 mb-4">Mis otros escritos</p>
			<ul class="mb-4">
				{posts.map((post) => (
					<li class="flex gap-5 p-1">
						<p class="opacity-70 min-w-44">{formatDate(post.data.date)}</p>
						<Link href={`/${post.slug}`}>
							{post.data.title}
						</Link>
					</li>
				))}
			</ul>

			<Link href="#" className="opacity-70">
				Ver todos →
			</Link>
		</section>
	</main>
</Layout>

<style>
	.last--post:hover h2 span {
		background-color: #ffd8a8;
	}
</style>
