---
import Layout from '../layouts/Layout.astro';
import Divider from '../components/Divider.astro';
import { homePageContent } from '../config.js';

---

<Layout	seo={homePageContent.seo}>
	<main>
		<!-- Lo último -->
		<section class="py-4">
			<p class="text-xl opacity-70">Lo último</p>
			<div id="last-post" class="cursor-pointer">
				<h2 class="text-2xl">
					<span class="inline-block rounded-bl-lg rounded-tl-3xl rounded-tr-md rounded-br-sm transition-colors duration-300">
						Lloré y no me dolió
					</span>
				</h2>
				<p class="mb-0 opacity-70">29 de diciembre de 2022</p>
				<p class="font-sans">
					Desde hace mucho tiempo he sentido ardor en los ojos cuando salen lágrimas de ellos.
				</p>
				<button class="opacity-70">
					Continuar leyendo →
				</button>
			</div>
		</section>

		<Divider />
	</main>
</Layout>

<style>
	#last-post:hover h2 span {
		background-color: #ffd8a8;
	}
</style>
