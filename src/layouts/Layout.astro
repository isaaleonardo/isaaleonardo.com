---
const { seo } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="./src/assets/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content="./src/assets/image.svg" />
  </head>
	<body>
		<div class="w-full max-w-screen-md m-auto px-10">
			<header class="text-header py-8">
				<ul class="flex justify-between gap-4">
					<li class="flex-grow flex gap-3">
						<a href="/">Isaac Leonardo M.</a>
						<ul class="hidden md:flex gap-1 items-center">
							<li>
								<a href="#"><img src="./src/assets/icons/twitter.svg" alt="Twitter icon" /></a>
							</li>
							<li>
								<a href="#"><img src="./src/assets/icons/instagram.svg" alt="Instagram icon" /></a>
							</li>
							<li>
								<a href="#"><img src="./src/assets/icons/linkedin.svg" alt="LinkedIn icon" /></a>
							</li>
						</ul>
					</li>
					<li class="opacity-70 hover:opacity-100 transition-opacity duration-300">
						<a href="/about">Sobre mí</a>
					</li>
					<li class="opacity-70 hover:opacity-100 transition-opacity duration-300 hidden sm:block">
						<a href="/now">Actualidad</a>
					</li>
				</ul>
			</header>
			<slot />
		</div>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Excalifont';
		src: url('../assets/fonts/excalifont-regular.woff2') format('woff2');
		font-weight: normal;
		font-style: normal;
	}

	body {
		font-family: 'Excalifont';
		background-color: #fffcf0;
	}

	.text-header {
		font-size: clamp(1rem, 2.5vw, 1.5rem);
	}
</style>
