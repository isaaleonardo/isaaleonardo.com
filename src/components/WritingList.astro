---
import Link from "./Link.astro";

function formatDate(originalDate) {
  // Parse the original date string into a Date object
  const date = new Date(originalDate);

  // Extract the year and month
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0'); // Get month (0-indexed) and pad with leading zero

  // Format the date as "YYYY · MM"
  return `${year} · ${month}`;
}

const { posts, avoidedPost, numberOfPosts } = Astro.props;
---
<section class="py-4">
  <p class="text-xl opacity-70 mb-4">
    {`Mis ${numberOfPosts ? "otros" : ""} escritos`}
  </p>
  <ul class="mb-4">
    {posts.slice(0, numberOfPosts)
      .map(post => {
        if (post.slug !== avoidedPost.slug) {
          return (
            <li class="flex gap-2">
              <p class="opacity-70 py-1">
                {formatDate(post.data.date)}
              </p>
              <Link href={`/${post.slug}`}>
                {post.data.title}
              </Link>
            </li>
          )
        }
      })
    }
  </ul>

  {numberOfPosts && (
    <Link href="/posts" className="opacity-70">
      Ver todos →
    </Link>
  )}
</section>
