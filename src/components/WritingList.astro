---
import Link from "./Link.astro";
import { formatDate } from "../utils";

const { posts, avoidedPost } = Astro.props;
---
<section class="py-4">
  <p class="text-xl opacity-70 mb-4">Mis otros escritos</p>
  <ul class="mb-4">
    {posts.map(post => {
      if (post.slug !== avoidedPost.slug) {
        return (
          <li class="flex gap-1">
            <p class="opacity-70 min-w-44 py-1">{formatDate(post.data.date)}</p>
            <Link href={`/${post.slug}`}>
              {post.data.title}
            </Link>
          </li>
        )
      }
    })}
  </ul>

  <Link href="#" className="opacity-70">
    Ver todos →
  </Link>
</section>
