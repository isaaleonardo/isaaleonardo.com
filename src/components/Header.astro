---
import Link from "./Link.astro";
---

<header class="text-header py-8">
  <ul class="flex justify-between gap-4">
    <li class="flex-grow flex gap-3 max-h-8">
      <a href="/">Isaac Leonardo M.</a>
      <ul class="hidden md:flex gap-1 items-center">
        <li>
          <a href="https://twitter.com/isaaleonardo" target="_blank" rel="noopener noreferrer">
            <img src="./src/assets/icons/twitter.svg" alt="Twitter icon" />
          </a>
        </li>
        <li>
          <a href="https://instagram.com/isaaleonardo" target="_blank" rel="noopener noreferrer">
            <img src="./src/assets/icons/instagram.svg" alt="Instagram icon" />
          </a>
        </li>
        <li>
          <a href="https://linkedin.com/in/isaaleonardo" target="_blank" rel="noopener noreferrer">
            <img src="./src/assets/icons/linkedin.svg" alt="Linkedin icon" />
          </a>
        </li>
      </ul>
    </li>
    <li>
      <Link href="/sobre-mi">Sobre mí</Link>
    </li>
  </ul>
</header>
