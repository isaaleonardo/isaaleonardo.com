---
const { href, className, external } = Astro.props;
---
<span class={
  `inline-block p-1 rounded-bl-lg rounded-tl-3xl rounded-tr-md rounded-br-sm hover:bg-[#ffd8a8] transition-colors duration-300
  ${className}
  `
}>
  <a
    href={href}
    class="underline"
    target={external ? "_blank" : ""}
    rel={external ? "noopener noreferrer" : ""}
  >
    <slot />
  </a>
</span>
